# =============================================
# OCR ENGINE ENVIRONMENT CONFIGURATION
# =============================================

# =============================================
# GEMINI API CONFIGURATION (REQUIRED)
# =============================================
# Primary API key
GEMINI_API_KEY=your_primary_api_key_here

# Additional API keys for load balancing (HIGHLY RECOMMENDED)
GEMINI_API_KEY_1=your_first_api_key_here
GEMINI_API_KEY_2=your_second_api_key_here
GEMINI_API_KEY_3=your_third_api_key_here
GEMINI_API_KEY_4=your_fourth_api_key_here
GEMINI_API_KEY_5=your_fifth_api_key_here
# Add more keys as needed (up to GEMINI_API_KEY_10)

# =============================================
# API TIMEOUT & RETRY CONFIGURATION
# =============================================
# Individual API call timeout (seconds)
GEMINI_API_TIMEOUT=720

# Overall process timeout (seconds)
OVERALL_PROCESS_TIMEOUT=1200

# Maximum retry attempts
GEMINI_MAX_RETRIES=6

# Base retry delay (seconds)
GEMINI_BASE_RETRY_DELAY=15

# Maximum retry delay (seconds)
GEMINI_MAX_RETRY_DELAY=120

# Exponential backoff multiplier
GEMINI_EXPONENTIAL_MULTIPLIER=1.5

# Overload error delay multiplier
GEMINI_OVERLOAD_MULTIPLIER=2.0

# =============================================
# PRO MODEL RATE LIMITING
# =============================================
# Minimum delay between Pro model calls (seconds)
PRO_MODEL_MIN_DELAY=15.0

# Delay after any Pro model error (seconds)
PRO_MODEL_ERROR_DELAY=30.0

# Delay after Pro model overload error (seconds)
PRO_MODEL_OVERLOAD_DELAY=60.0

# Attempt threshold for Flash model fallback
FLASH_FALLBACK_THRESHOLD=3

# =============================================
# PROJECTION TIMING CONFIGURATION (NEW)
# =============================================
# Base year for projections (e.g., 2026)
PROJECTION_BASE_YEAR=2026

# Use calendar year (true) vs Australian FY (false)
USE_CALENDAR_YEAR=true

# Enforce realistic Q1 month-to-month variability
ENFORCE_Q1_VARIABILITY=true

# Minimum monthly variance threshold (0.05 = 5%)
MINIMUM_MONTHLY_VARIANCE=0.05

# =============================================
# CORS & FRONTEND CONFIGURATION
# =============================================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# =============================================
# SERVER CONFIGURATION
# =============================================
# Set to "true" for main server process logging
OCR_SERVER_MAIN=true