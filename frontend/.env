# Frontend .env file
# Add this to your frontend/.env file

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000

# CRITICAL FIX: Increase API timeout to match backend
# Backend allows 20 minutes (1200s), so frontend should allow 25+ minutes
VITE_API_TIMEOUT=1500000  # 25 minutes in milliseconds

# Multi-PDF specific timeout (even longer for complex analysis)
VITE_MULTI_PDF_TIMEOUT=1800000  # 30 minutes in milliseconds

# Development settings
VITE_DEBUG_API=true
VITE_SHOW_PROGRESS=true